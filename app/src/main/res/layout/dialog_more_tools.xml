<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_reader_controls"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="14dp"
    android:paddingEnd="20dp"
    android:paddingBottom="26dp">

    <View
        android:layout_width="48dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_sheet_handle" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="More PDF Tools"
        android:textColor="@color/title_text"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Choose a PDF utility to perform quick offline actions"
        android:textColor="@color/body_text"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/sheetPreflightButton"
            style="@style/Widget.PDFZipExporter.Button.MiniTool"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/preflight_home"
            app:icon="@drawable/ic_tool_preflight_24"
            app:iconGravity="textStart" />

        <Space
            android:layout_width="10dp"
            android:layout_height="wrap_content" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/sheetCropPageButton"
            style="@style/Widget.PDFZipExporter.Button.MiniTool"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/crop_page_tool"
            app:icon="@drawable/ic_tool_crop_24"
            app:iconGravity="textStart" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/sheetDuplicatePageButton"
            style="@style/Widget.PDFZipExporter.Button.MiniTool"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/duplicate_page_tool"
            app:icon="@drawable/ic_tool_duplicate_24"
            app:iconGravity="textStart" />

        <Space
            android:layout_width="10dp"
            android:layout_height="wrap_content" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/sheetMergePdfButton"
            style="@style/Widget.PDFZipExporter.Button.MiniTool"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/merge_pdfs_tool"
            app:icon="@drawable/ic_tool_merge_24"
            app:iconGravity="textStart" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/sheetSplitPdfButton"
            style="@style/Widget.PDFZipExporter.Button.MiniTool"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/split_pdf_tool"
            app:icon="@drawable/ic_tool_split_24"
            app:iconGravity="textStart" />

        <Space
            android:layout_width="10dp"
            android:layout_height="wrap_content" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/sheetCleanupPageButton"
            style="@style/Widget.PDFZipExporter.Button.MiniTool"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/quick_tool_cleanup"
            app:icon="@drawable/ic_delete_24"
            app:iconGravity="textStart" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/sheetBatchCompressButton"
            style="@style/Widget.PDFZipExporter.Button.MiniTool"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/batch_compress_tool"
            app:icon="@drawable/ic_tool_compress_24"
            app:iconGravity="textStart" />

        <Space
            android:layout_width="10dp"
            android:layout_height="wrap_content" />

        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />
    </LinearLayout>
</LinearLayout>
