<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/gridPageCard"
    android:layout_width="match_parent"
    android:layout_height="130dp"
    android:layout_margin="6dp"
    app:cardBackgroundColor="@color/card_surface_strong"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/card_stroke"
    app:strokeWidth="1dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/gridPageImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:adjustViewBounds="false"
            android:background="@drawable/bg_viewer_page"
            android:contentDescription="@null"
            android:padding="4dp"
            android:scaleType="fitCenter" />

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/gridPageLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:scaleX="0.7"
            android:scaleY="0.7"
            app:indicatorColor="@color/progress_color" />

        <TextView
            android:id="@+id/gridPageNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_status_panel"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:textColor="@color/title_text"
            android:textSize="9sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/gridPageDeleteButton"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="top|end"
            android:layout_margin="4dp"
            app:cardBackgroundColor="#E53935"
            app:cardCornerRadius="15dp"
            app:cardElevation="3dp"
            app:strokeColor="#FFFFFF"
            app:strokeWidth="1.5dp">

            <ImageView
                android:id="@+id/gridPageDeleteButtonIcon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_delete_24"
                app:tint="@android:color/white"
                android:contentDescription="@null" />
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>
</com.google.android.material.card.MaterialCardView>
