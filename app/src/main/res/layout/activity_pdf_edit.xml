<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/viewer_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Clean White Toolbar -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/editToolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/card_surface"
            android:elevation="0dp"
            android:minHeight="56dp"
            android:paddingStart="4dp"
            android:paddingEnd="8dp"
            app:navigationIcon="@drawable/ic_arrow_back_24"
            app:navigationIconTint="@color/title_text"
            app:subtitleTextColor="@color/body_text"
            app:titleTextColor="@color/title_text">

            <!-- Toolbar Actions (Undo/Redo & Save) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/undoEditButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_undo_24"
                    app:tint="@color/title_text"
                    android:contentDescription="@string/visual_edit_undo" />

                <!-- Redo button made visible -->
                <ImageButton
                    android:id="@+id/redoEditButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_redo_24"
                    app:tint="@color/title_text"
                    android:contentDescription="Redo"
                    android:visibility="visible" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/saveEditedPdfButton"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:text="Save"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp"
                    app:backgroundTint="@color/progress_color"
                    app:cornerRadius="18dp" />

            </LinearLayout>
        </com.google.android.material.appbar.MaterialToolbar>

        <!-- Thin bottom divider under toolbar -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/card_stroke" />

        <!-- Compact Page Navigation Header -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/editNavigationCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/card_surface"
            app:cardCornerRadius="0dp"
            app:cardElevation="2dp"
            app:strokeWidth="0dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <!-- Left Chevron -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/editPreviousPageButton"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    app:icon="@drawable/ic_chevron_left_24"
                    app:iconTint="@color/title_text" />

                <!-- Page indicator text (Clickable to jump) -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/editPageIndicator"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/title_text"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:text="Page 1 of 1" />

                    <TextView
                        android:id="@+id/editPageMeta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/body_text"
                        android:textSize="12sp"
                        android:text="document.pdf" />

                </LinearLayout>

                <!-- Right Chevron -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/editNextPageButton"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    app:icon="@drawable/ic_chevron_right_24"
                    app:iconTint="@color/title_text" />

            </RelativeLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Canvas and Overlay Area -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <HorizontalScrollView
                android:id="@+id/editHorizontalScrollView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:overScrollMode="never"
                android:scrollbars="none">

                <androidx.core.widget.NestedScrollView
                    android:id="@+id/editScrollView"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:fillViewport="true"
                    android:overScrollMode="never"
                    android:paddingStart="12dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="12dp"
                    android:scrollbars="none">

                    <FrameLayout
                        android:id="@+id/editCanvasViewport"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|center_horizontal">

                        <FrameLayout
                            android:id="@+id/editCanvasFrame"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="top|center_horizontal"
                            android:background="@drawable/bg_document_sheet">

                            <ImageView
                                android:id="@+id/editPageImage"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="@null"
                                android:scaleType="fitXY" />

                            <com.renameapk.pdfzip.PdfMarkupOverlayView
                                android:id="@+id/editOverlay"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent" />
                        </FrameLayout>
                    </FrameLayout>
                </androidx.core.widget.NestedScrollView>
            </HorizontalScrollView>

            <LinearLayout
                android:id="@+id/editLoadingGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:indicatorColor="@color/progress_color" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/visual_edit_loading"
                    android:textColor="@color/title_text"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/editErrorText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_margin="24dp"
                android:background="@drawable/bg_note_panel"
                android:gravity="center"
                android:padding="24dp"
                android:textColor="@color/title_text"
                android:textSize="16sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- Floating Reorder/Pages Capsule -->
            <LinearLayout
                android:id="@+id/editReorderButtonContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_floating_bar_zoom"
                android:elevation="6dp"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="6dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/editReorderButton"
                    style="@style/Widget.PDFZipExporter.Button.EditorTool"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:contentDescription="Reorder Pages"
                    app:icon="@drawable/ic_view_sidebar_24"
                    app:iconSize="20dp"
                    app:iconTint="@color/body_text" />
            </LinearLayout>

            <!-- Floating Vertical Zoom Capsule -->
            <LinearLayout
                android:id="@+id/editZoomButtons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_floating_bar_zoom"
                android:elevation="6dp"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="6dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/editZoomInButton"
                    style="@style/Widget.PDFZipExporter.Button.EditorTool"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:contentDescription="@string/visual_edit_zoom_in"
                    app:icon="@drawable/ic_zoom_in_24"
                    app:iconSize="20dp"
                    app:iconTint="@color/body_text" />

                <View
                    android:layout_width="24dp"
                    android:layout_height="1dp"
                    android:background="@color/card_stroke"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="4dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/editZoomOutButton"
                    style="@style/Widget.PDFZipExporter.Button.EditorTool"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:contentDescription="@string/visual_edit_zoom_out"
                    app:icon="@drawable/ic_zoom_out_24"
                    app:iconSize="20dp"
                    app:iconTint="@color/body_text" />
            </LinearLayout>

            <!-- Floating bottom tools container (charcoal capsule) -->
            <LinearLayout
                android:id="@+id/editControlsPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="24dp"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:clipToPadding="false">

                <FrameLayout
                    android:id="@+id/editSelectedCard"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:visibility="gone"
                    android:clipChildren="false"
                    android:clipToPadding="false">

                    <LinearLayout
                        android:id="@+id/editUndoRow"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_floating_bar"
                        android:elevation="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/selectedSmallerButton"
                            style="@style/Widget.PDFZipExporter.Button.EditorTool"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginEnd="4dp"
                            android:contentDescription="Smaller"
                            app:icon="@drawable/ic_zoom_out_24" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/selectedLargerButton"
                            style="@style/Widget.PDFZipExporter.Button.EditorTool"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginEnd="4dp"
                            android:contentDescription="Larger"
                            app:icon="@drawable/ic_zoom_in_24" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/toggleBoldButton"
                            style="@style/Widget.PDFZipExporter.Button.EditorTool"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginEnd="4dp"
                            android:contentDescription="Toggle Bold"
                            app:icon="@drawable/ic_tool_text_24" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/selectedDeleteButton"
                            style="@style/Widget.PDFZipExporter.Button.EditorTool"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:contentDescription="Delete Selected"
                            app:icon="@drawable/ic_delete_24"
                            app:iconTint="@color/tool_rose_text" />
                    </LinearLayout>
                </FrameLayout>

                <LinearLayout
                    android:id="@+id/editToolsCard"
                    android:layout_width="wrap_content"
                    android:layout_height="56dp"
                    android:layout_gravity="center_horizontal"
                    android:background="@drawable/bg_floating_bar_large"
                    android:elevation="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp">

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/editToolToggleGroup"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:checkedButton="@id/moveToolButton"
                        app:selectionRequired="true"
                        app:singleSelection="true">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/moveToolButton"
                            style="@style/Widget.PDFZipExporter.Button.EditorTool"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginEnd="4dp"
                            android:contentDescription="@string/visual_edit_move"
                            app:icon="@drawable/ic_tool_move_24"
                            app:iconTint="@color/editor_toggle_icon" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/drawToolButton"
                            style="@style/Widget.PDFZipExporter.Button.EditorTool"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginEnd="4dp"
                            android:contentDescription="@string/visual_edit_draw"
                            app:icon="@drawable/ic_tool_draw_24"
                            app:iconTint="@color/editor_toggle_icon" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/highlightToolButton"
                            style="@style/Widget.PDFZipExporter.Button.EditorTool"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:contentDescription="@string/visual_edit_highlight"
                            app:icon="@drawable/ic_tool_highlight_24"
                            app:iconTint="@color/editor_toggle_icon" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="24dp"
                        android:background="#475569"
                        android:layout_marginStart="6dp"
                        android:layout_marginEnd="6dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/addTextButton"
                        style="@style/Widget.PDFZipExporter.Button.EditorTool"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="4dp"
                        android:contentDescription="@string/visual_edit_tool_text"
                        app:icon="@drawable/ic_tool_text_24"
                        app:iconTint="@color/editor_toggle_icon" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/addImageButton"
                        style="@style/Widget.PDFZipExporter.Button.EditorTool"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="4dp"
                        android:contentDescription="@string/visual_edit_tool_image"
                        app:icon="@drawable/ic_tool_image_24"
                        app:iconTint="@color/editor_toggle_icon" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/deletePageButton"
                        style="@style/Widget.PDFZipExporter.Button.EditorTool"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:contentDescription="@string/visual_edit_delete_page"
                        app:icon="@drawable/ic_delete_24"
                        app:iconTint="@color/editor_toggle_icon" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="24dp"
                        android:background="#475569"
                        android:layout_marginStart="6dp"
                        android:layout_marginEnd="6dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/moreToolsButton"
                        style="@style/Widget.PDFZipExporter.Button.EditorTool"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:contentDescription="@string/visual_edit_tool_tools"
                        app:icon="@drawable/ic_tool_more_24"
                        app:iconTint="@color/editor_toggle_icon" />

                </LinearLayout>
            </LinearLayout>

        </FrameLayout>
    </LinearLayout>

    <!-- HELD / UNUSED DUMMY VIEWS FOR BINDING COMPATIBILITY -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone">

        <TextView
            android:id="@+id/editSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/editToolHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <LinearLayout
            android:id="@+id/editJumpRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/editJumpToPageButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
            <SeekBar
                android:id="@+id/editPageSeekBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/editHistoryRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <Space
                android:id="@+id/editPrimaryActionsSpacerStart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
            <Space
                android:id="@+id/editPrimaryActionsSpacerEnd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>



        <com.google.android.material.card.MaterialCardView
            android:id="@+id/editActionsCard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/selectionOnlyStatusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/pageNumbersGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <com.google.android.material.chip.Chip
                    android:id="@+id/pageNumbersChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </com.google.android.material.chip.ChipGroup>
            <LinearLayout
                android:id="@+id/editUndoActionsRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <Space
                    android:id="@+id/deletePageSpacerOne"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
                <Space
                    android:id="@+id/deletePageSpacerTwo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/clearPageButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/previewEditedPdfButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

</FrameLayout>
